PORT=3001
DOMAIN=localhost:3001
MONGODB_URI=mongodb://localhost:27017/devportal
REDIS_URL=redis://localhost:6379
REQUIRE_REDIS=false
# Optional stable instance label; Railway can provide its own service instance ID.
# INSTANCE_ID=local-dev

# Managed OIDC configuration
OIDC_ISSUER=https://your-tenant.example.com/
OIDC_AUDIENCE=https://api.example.com
# Optional when the provider does not expose the standard issuer JWKS path
# OIDC_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json